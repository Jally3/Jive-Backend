PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
TMDB_READ_ACCESS_TOKEN=replace-me
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_CONCURRENCY=2
TMDB_PAGES=5
TMDB_REQUEST_TIMEOUT_MS=10000
PUBLIC_RATE_LIMIT_MAX=120
# Safe when HOST is loopback and only Caddy can reach the process.
TRUST_PROXY=true
# Optional restart recovery. Leave empty for a pure in-memory service.
CATALOG_STATE_FILE=/var/lib/jive-catalog/state.json
# Monitoring UI is only safe behind authenticated Nginx/Caddy access.
ADMIN_ENABLED=true
MONITORING_STATE_FILE=/var/lib/jive-catalog/monitoring.json
MONITORING_RETENTION_DAYS=90
MONITORING_TIMEZONE=Asia/Shanghai
# Minimum interval between event-triggered saves. This does not create a polling timer.
MONITORING_SAVE_INTERVAL_MS=60000

# Personalized recommendation (disabled until all secrets and Ark values are configured).
RECOMMENDATION_ENABLED=false
ARK_API_KEY=replace-me
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=replace-with-endpoint-or-model-id
ARK_REQUEST_TIMEOUT_MS=18000
ARK_MAX_OUTPUT_TOKENS=4096
ARK_MAX_RESPONSE_BYTES=262144
ARK_TEMPERATURE=0.4
# Contract/account prices in CNY per one million tokens; keep explicit even for a token plan.
ARK_INPUT_YUAN_PER_MILLION_TOKENS=replace-with-contract-price
ARK_OUTPUT_YUAN_PER_MILLION_TOKENS=replace-with-contract-price
RECOMMENDATION_PROMPT_VERSION=v1
RECOMMENDATION_CURSOR_SECRET=replace-with-at-least-32-random-bytes
RECOMMENDATION_SUBJECT_SECRET=replace-with-at-least-32-random-bytes
RECOMMENDATION_FINGERPRINT_SECRET=replace-with-at-least-32-random-bytes
RECOMMENDATION_SESSION_TTL_MS=1800000
RECOMMENDATION_MAX_SESSIONS=1000
RECOMMENDATION_MAX_CACHE_ENTRIES=500
RECOMMENDATION_CACHE_FRESH_TTL_MS=1800000
RECOMMENDATION_CACHE_STALE_TTL_MS=86400000
RECOMMENDATION_CLEANUP_INTERVAL_MS=60000
RECOMMENDATION_MAX_CONCURRENCY=4
RECOMMENDATION_MAX_QUEUE=16
RECOMMENDATION_SUBJECT_RATE_LIMIT_PER_MINUTE=2
RECOMMENDATION_SOURCE_RATE_LIMIT_PER_MINUTE=30
RECOMMENDATION_SUBJECT_DAILY_CALLS=12
RECOMMENDATION_SUBJECT_DAILY_TOKENS=100000
RECOMMENDATION_GLOBAL_DAILY_CALLS=500
RECOMMENDATION_GLOBAL_DAILY_TOKENS=5000000
RECOMMENDATION_GLOBAL_DAILY_COST_YUAN=50
RECOMMENDATION_BUDGET_TIMEZONE=Asia/Shanghai
RECOMMENDATION_BUDGET_STATE_FILE=/var/lib/jive-catalog/recommendation-budget.json
RECOMMENDATION_MIN_ITEMS_FOR_NEXT_PAGE=4
